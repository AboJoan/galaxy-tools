CDS_PAIR_DIR = f"{WORK}/03_pairs_classified"
CDS_INTERP_FIGDIR = f"{RES}/02_figures/03_cds_mapping_interpretation"

PLS_GLOBAL_IDS = {
    "02": "09",
    "031": "10",
    "032": "11",
    "05": "12",
    "08": "13",
}

CDS_INTERP_INPUTS = (
    expand(f"{CDS_PAIR_DIR}/{{i}}_pairs_classified.tsv", i=BAC_SAMPLES)
    +
    expand(f"{CDS_PAIR_DIR}/{{i}}_pairs_classified.tsv", i=[PLS_GLOBAL_IDS[x] for x in PLS_SAMPLES])
)

rule collect_pairs_classified:
    input:
        bac=expand(f"{WORK_CDSDIR}/bac/{{i}}/module3_table3_wide.tsv", i=BAC_SAMPLES),
        pls=expand(f"{WORK_CDSDIR}/pls/{{i}}/module3_table3_wide.tsv", i=PLS_SAMPLES)
    output:
        CDS_INTERP_INPUTS
    run:
        from pathlib import Path
        import shutil

        outdir = Path(CDS_PAIR_DIR)
        outdir.mkdir(parents=True, exist_ok=True)

        for i in BAC_SAMPLES:
            src = Path(f"{WORK_CDSDIR}/bac/{i}/pairs_classified.tsv")
            dst = outdir / f"{i}_pairs_classified.tsv"
            shutil.copyfile(src, dst)

        for i in PLS_SAMPLES:
            gid = PLS_GLOBAL_IDS[i]
            src = Path(f"{WORK_CDSDIR}/pls/{i}/pairs_classified.tsv")
            dst = outdir / f"{gid}_pairs_classified.tsv"
            shutil.copyfile(src, dst)


rule cds_mapping_interpretation:
    input:
        CDS_INTERP_INPUTS
    output:
        summary=f"{FINALDIR}/CDS_mapping_summary_NCBI_reference_vs_Prodigal_reannotation.tsv",
        fig1=f"{CDS_INTERP_FIGDIR}/Figure_1A_bacterial_chromosomes_NCBI_vs_Prodigal_CDS_mapping.png",
        fig2=f"{CDS_INTERP_FIGDIR}/Figure_1B_plasmids_NCBI_vs_Prodigal_CDS_mapping.png",
        fig3=f"{CDS_INTERP_FIGDIR}/Figure_2A_bacterial_chromosomes_mean_CDS_length_change.png",
        fig4=f"{CDS_INTERP_FIGDIR}/Figure_2B_plasmids_mean_CDS_length_change.png"
    log:
        f"{LOGDIR}/cds_mapping_interpretation.log"
    shell:
        r"""
        set -euo pipefail

        MPLBACKEND=Agg python3 "{SCR}/pairs_classified_inter.py" \
          2>&1 | tee "{log}" >&2

        test -s "{output.summary}"
        test -s "{output.fig1}"
        test -s "{output.fig2}"
        test -s "{output.fig3}"
        test -s "{output.fig4}"
        """
