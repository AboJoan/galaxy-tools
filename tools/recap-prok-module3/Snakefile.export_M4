with open(gb_file) as inp, open(out_file, "w") as out:
    for line in inp:
        if line.startswith("FEATURES"):
            in_features = True
            out.write(line)
            continue

        if line.startswith("ORIGIN"):
            flush(out)
            out.write(line)
            in_features = False
            block = []
            keep_block = False
            continue

        if not in_features:
            out.write(line)
            continue

        m = feature_re.match(line)

        if m:
            flush(out)
            block = [line]
            keep_block = False

            ftype = m.group(1)
            loc_text = m.group(2)
            found = re.findall(r"\d+\.\.\d+", loc_text)

            if ftype == "source":
                keep_block = True
            elif ftype in ["gene", "CDS"]:
                if any(x in coords for x in found):
                    keep_block = True
                    if ftype == "CDS":
                        kept_cds += 1
                    elif ftype == "gene":
                        kept_gene += 1
        else:
            block.append(line)

print(f"Kept CDS: {{kept_cds}}")
print(f"Kept genes: {{kept_gene}}")
if kept_cds == 0:
    raise SystemExit("ERROR: no CDS kept in mapped GenBank")
PY

        test -s "{output}"
        """


# ============================================================
# 5) Export all protein sets for Module 4
# Rename old BASIHUMIx / PLSIHUMIx names into Re-annotated names
# ============================================================

rule export_reannotated_bac:
    input:
        f"{BAC_FAA_DIR}/BASIHUMIx_{{i}}.proteins.faa"
    output:
        f"{OUT}/01_bacterial/04_all_proteins/Re-annotated_{{i}}.faa"
    shell:
        r"""
        set -euo pipefail
        cp -f "{input}" "{output}"
        test -s "{output}"
        """


rule export_reannotated_pls:
    input:
        f"{PLS_FAA_DIR}/PLSIHUMIx_{{i}}.proteins.faa"
    output:
        f"{OUT}/02_plasmids/04_all_proteins/PLRe-annotated_{{i}}.faa"
    shell:
        r"""
        set -euo pipefail
        cp -f "{input}" "{output}"
        test -s "{output}"
        """


rule ref_mapped_faa_bac:
    input:
        ids=f"{OUT}/01_bacterial/01_ref_ids/{{i}}_ref_all_ids.txt",
        faa=f"{BAC_FAA_DIR}/Ref_NCBI_{{i}}.faa"
    output:
        f"{OUT}/01_bacterial/04_all_proteins/Ref_NCBI_mapped_{{i}}.faa"
    shell:
        r"""
        set -euo pipefail
        seqkit grep -f "{input.ids}" "{input.faa}" -o "{output}"
        test -s "{output}"
        """


rule ref_mapped_faa_pls:
    input:
        ids=f"{OUT}/02_plasmids/01_ref_ids/{{i}}_ref_all_ids.txt",
        faa=f"{PLS_FAA_DIR}/PLRef_NCBI_{{i}}.faa"
    output:
        f"{OUT}/02_plasmids/04_all_proteins/PLRef_NCBI_mapped_{{i}}.faa"
    shell:
        r"""
        set -euo pipefail
        seqkit grep -f "{input.ids}" "{input.faa}" -o "{output}"
        test -s "{output}"
        """


# ============================================================
# 6) Extract ONLY protein sets from GFF evidence
# Reference-only and Re-annotated-only
# ============================================================

rule ref_only_faa_bac:
    input:
        gff=f"{CDS_CLASS_DIR}/bac/{{i}}/gff/ref_unmapped.gff",
        faa=f"{BAC_FAA_DIR}/Ref_NCBI_{{i}}.faa"
    output:
        f"{OUT}/01_bacterial/05_only_proteins/Ref_NCBI_only_{{i}}.faa"
    shell:
        r"""
        set -euo pipefail

        tmp_ids="$(mktemp)"
        awk -F'\t' '
          $0 !~ /^#/ && NF>=9 && $3=="CDS" {{
            attr=$9
            id=""
            if (match(attr, /(^|;)ID=[^;]+/)) {{
              id=substr(attr, RSTART, RLENGTH)
              sub(/(^|;)ID=/, "", id)
            }} else if (match(attr, /protein_id=[^;]+/)) {{
              id=substr(attr, RSTART, RLENGTH)
              sub(/protein_id=/, "", id)
            }}
            gsub(/^cds-/, "", id)
            if (id!="") print id
          }}
        ' "{input.gff}" | sort -u > "$tmp_ids"

        if [ ! -s "$tmp_ids" ]; then
          : > "{output}"
        else
          seqkit grep -f "$tmp_ids" "{input.faa}" -o "{output}"
        fi

        rm -f "$tmp_ids"
        test -f "{output}"
        """


rule reann_only_faa_bac:
    input:
        gff=f"{CDS_CLASS_DIR}/bac/{{i}}/gff/reann_unmapped.gff",
        faa=f"{BAC_FAA_DIR}/BASIHUMIx_{{i}}.proteins.faa"
    output:
        f"{OUT}/01_bacterial/05_only_proteins/Re-annotated_only_{{i}}.faa"
    shell:
        r"""
        set -euo pipefail

        python3 - <<'PY'
from pathlib import Path
import re

gff = Path("{input.gff}")
faa = Path("{input.faa}")
out = Path("{output}")

ids = set()

with open(gff) as f:
    for line in f:
        if line.startswith("#"):
            continue
        p = line.rstrip("\n").split("\t")
        if len(p) < 9 or p[2] != "CDS":
            continue
        m = re.search(r"(?:^|;)ID=([^;]+)", p[8])
        if m:
            ids.add(m.group(1).replace("cds-", ""))

kept = 0
write = False

with open(faa) as inp, open(out, "w") as fh:
    for line in inp:
        if line.startswith(">"):
            header = line[1:].strip()
            first = header.split()[0]
            tokens = re.split(r"[^A-Za-z0-9_.-]+", header)
            write = first in ids or any(x in tokens for x in ids)
            if write:
                kept += 1
                fh.write(line)
        else:
            if write:
                fh.write(line)

print(f"Required IDs: {{len(ids)}}")
print(f"Kept proteins: {{kept}}")
PY

        test -f "{output}"
        """



rule ref_only_faa_pls:
    input:
        gff=f"{CDS_CLASS_DIR}/pls/{{i}}/gff/ref_unmapped.gff",
        faa=f"{PLS_FAA_DIR}/PLRef_NCBI_{{i}}.faa"
    output:
        f"{OUT}/02_plasmids/05_only_proteins/PLRef_NCBI_only_{{i}}.faa"
    shell:
        r"""
        set -euo pipefail

        tmp_ids="$(mktemp)"
        awk -F'\t' '
          $0 !~ /^#/ && NF>=9 && $3=="CDS" {{
            attr=$9
            id=""
            if (match(attr, /(^|;)ID=[^;]+/)) {{
              id=substr(attr, RSTART, RLENGTH)
              sub(/(^|;)ID=/, "", id)
            }} else if (match(attr, /protein_id=[^;]+/)) {{
              id=substr(attr, RSTART, RLENGTH)
              sub(/protein_id=/, "", id)
            }}
            gsub(/^cds-/, "", id)
            if (id!="") print id
          }}
        ' "{input.gff}" | sort -u > "$tmp_ids"

        if [ ! -s "$tmp_ids" ]; then
          : > "{output}"
        else
          seqkit grep -f "$tmp_ids" "{input.faa}" -o "{output}" || : > "{output}"
        fi

        rm -f "$tmp_ids"
        test -f "{output}"
        """

rule reann_only_faa_pls:
    input:
        gff=f"{CDS_CLASS_DIR}/pls/{{i}}/gff/reann_unmapped.gff",
        faa=f"{PLS_FAA_DIR}/PLSIHUMIx_{{i}}.proteins.faa"
    output:
        f"{OUT}/02_plasmids/05_only_proteins/PLRe-annotated_only_{{i}}.faa"
    shell:
        r"""
        set -euo pipefail

        python3 - <<'PY'
from pathlib import Path
import re

gff = Path("{input.gff}")
faa = Path("{input.faa}")
out = Path("{output}")

ids = set()

with open(gff) as f:
    for line in f:
        if line.startswith("#"):
            continue
        p = line.rstrip("\n").split("\t")
        if len(p) < 9 or p[2] != "CDS":
            continue
        m = re.search(r"(?:^|;)ID=([^;]+)", p[8])
        if m:
            ids.add(m.group(1).replace("cds-", ""))

kept = 0
write = False

with open(faa) as inp, open(out, "w") as fh:
    for line in inp:
        if line.startswith(">"):
            header = line[1:].strip()
            first = header.split()[0]
            tokens = re.split(r"[^A-Za-z0-9_.-]+", header)
            write = first in ids or any(x in tokens for x in ids)
            if write:
                kept += 1
                fh.write(line)
        else:
            if write:
                fh.write(line)

print("Required IDs:", len(ids))
print("Kept proteins:", kept)
PY

        test -f "{output}"
        """


# ============================================================
# 7) QC report for Ref-only ID recovery
# ============================================================
# ============================================================
# QC Ref-only recovery for Bacteria
# ============================================================
rule qc_ref_only_id_recovery_bac:
    output:
        f"{OUT}/01_bacterial/07_qc/ref_only_id_recovery_report.tsv"
    run:
        import pandas as pd
        from pathlib import Path

        qc_dir = Path(f"{OUT}/01_bacterial/07_qc/missing_ref_only_ids")
        qc_dir.mkdir(parents=True, exist_ok=True)

        table3 = pd.read_csv("04_results/01_final_tables/module3_bacterial_summary.tsv", sep="\t")
        table3.index = table3["Genome"].astype(int)

        rows = []

        for sample in BAC_IDS:
            sample_num = int(sample)
            required_ref_only_ids = table3.loc[sample_num, "REF_ONLY_{g}"]

            faa_file = Path(OUT) / "01_bacterial/05_only_proteins" / f"Ref_NCBI_only_{sample}.faa"
            mapped_ids = set()
            if faa_file.exists():
                with open(faa_file) as fh:
                    for line in fh:
                        if line.startswith(">"):
                            mapped_ids.add(line[1:].split()[0])

            miss_count = max(0, required_ref_only_ids - len(mapped_ids))

            miss_file = qc_dir / f"{sample}_missing_ref_only_ids.txt"
            with open(miss_file, "w") as out:
                out.write("\n".join(sorted(mapped_ids)) + "\n")

            rows.append({
                "sample": sample,
                "required_ref_only_ids": required_ref_only_ids,
                "found_in_reference_faa": len(mapped_ids),
                "missing_from_reference_faa": miss_count,
                "missing_ids_file": str(miss_file),
            })

        pd.DataFrame(rows).to_csv(output[0], sep="\t", index=False)


# ============================================================
# QC Ref-only recovery for Plasmids
# ============================================================
rule qc_ref_only_id_recovery_pls:
    output:
        f"{OUT}/02_plasmids/07_qc/ref_only_id_recovery_report.tsv"
    run:
        import pandas as pd
        from pathlib import Path

        qc_dir = Path(f"{OUT}/02_plasmids/07_qc/missing_ref_only_ids")
        qc_dir.mkdir(parents=True, exist_ok=True)

        table3 = pd.read_csv("04_results/01_final_tables/module3_plasmid_summary.tsv", sep="\t")
        table3.index = table3["Genome"].astype(int)

        rows = []

        for sample in PLS_IDS:
            sample_num = int(sample)
            required_ref_only_ids = table3.loc[sample_num, "REF_ONLY_{g}"]

            faa_file = Path(OUT) / "02_plasmids/05_only_proteins" / f"PLRef_NCBI_only_{sample}.faa"
            mapped_ids = set()
            if faa_file.exists():
                with open(faa_file) as fh:
                    for line in fh:
                        if line.startswith(">"):
                            mapped_ids.add(line[1:].split()[0])

            miss_count = max(0, required_ref_only_ids - len(mapped_ids))

            miss_file = qc_dir / f"{sample}_missing_ref_only_ids.txt"
            with open(miss_file, "w") as out:
                out.write("\n".join(sorted(mapped_ids)) + "\n")

            rows.append({
                "sample": sample,
                "required_ref_only_ids": required_ref_only_ids,
                "found_in_reference_faa": len(mapped_ids),
                "missing_from_reference_faa": miss_count,
                "missing_ids_file": str(miss_file),
            })

        pd.DataFrame(rows).to_csv(output[0], sep="\t", index=False)

# ============================================================
# Manifest for Module4
# ============================================================
        
rule manifest:
    input:
        BAC_REF_MAPPED_FAA,
        PLS_REF_MAPPED_FAA,
        BAC_ALL_PROT,
        PLS_ALL_PROT,
        BAC_ONLY,
        PLS_ONLY,
        BAC_REF_MAPPED_GB,
        PLS_REF_MAPPED_GB,
        BAC_REF_ONLY_QC,
        PLS_REF_ONLY_QC
    output:
        f"{OUT}/module4_ready_manifest.tsv"
    run:
        import pandas as pd
        from pathlib import Path

        rows = []
        for f in input:
            pth = Path(str(f))
            rows.append({
                "file": str(pth),
                "exists": pth.exists(),
                "size_bytes": pth.stat().st_size if pth.exists() else 0,
            })

        pd.DataFrame(rows).to_csv(output[0], sep="\t", index=False)
