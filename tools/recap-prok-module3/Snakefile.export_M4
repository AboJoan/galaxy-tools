# ============================================================
# Module 3.5 — Export Module 4-ready inputs
# This Snakefile does NOT modify Module 3 outputs.
# It only reads Module 3 results + external NCBI files
# and prepares clean inputs for Module 4.
# ============================================================

from pathlib import Path

WORK = "02_work"
INP  = "00_input"
RES  = "04_results"

CDS_CLASS_DIR = f"{WORK}/02_cds_classification"

EXT_M4 = f"{INP}/03_extrnal_files_for_M4"

OUT = f"{INP}/04_module4_ready_inputs"
LOG = f"{RES}/00_logs"

# ------------------------------------------------------------
# External files for Module 4
# ------------------------------------------------------------
BAC_GB_DIR  = f"{EXT_M4}/01_bacterial/01_GenBank"
BAC_CDS_DIR = f"{EXT_M4}/01_bacterial/02_cds"
BAC_FAA_DIR = f"{EXT_M4}/01_bacterial/03_Protein_genes"

PLS_GB_DIR  = f"{EXT_M4}/02_plasmids/01_GenBank"
PLS_CDS_DIR = f"{EXT_M4}/02_plasmids/02_cds"
PLS_FAA_DIR = f"{EXT_M4}/02_plasmids/03_Protein_genes"


def discover_ids(stype):
    """
    stype = bac or pls
    Detect IDs from Module 3 CDS classification folders:
      02_work/02_cds_classification/bac/01/
      02_work/02_cds_classification/pls/02/
    """
    d = Path(CDS_CLASS_DIR) / stype
    if not d.exists():
        return []
    ids = []
    for p in d.iterdir():
        if p.is_dir() and (p / "tmp" / "ref_all_ids.txt").exists():
            ids.append(p.name)
    return sorted(ids, key=lambda x: int(x))


BAC_IDS = discover_ids("bac")
PLS_IDS = discover_ids("pls")

print("Detected bacterial IDs:", BAC_IDS)
print("Detected plasmid IDs:", PLS_IDS)


# ------------------------------------------------------------
# Final expected outputs
# ------------------------------------------------------------
BAC_REF_IDS = expand(f"{OUT}/01_bacterial/01_ref_ids/{{i}}_ref_all_ids.txt", i=BAC_IDS)
PLS_REF_IDS = expand(f"{OUT}/02_plasmids/01_ref_ids/{{i}}_ref_all_ids.txt", i=PLS_IDS)

BAC_REF_ONLY_QC = f"{OUT}/01_bacterial/07_qc/ref_only_id_recovery_report.tsv"
PLS_REF_ONLY_QC = f"{OUT}/02_plasmids/07_qc/ref_only_id_recovery_report.tsv"

BAC_REF_MAPPED_CDS = expand(f"{OUT}/01_bacterial/02_ref_mapped_cds/Ref_NCBI_mapped_cds_{{i}}.fna", i=BAC_IDS)
PLS_REF_MAPPED_CDS = expand(f"{OUT}/02_plasmids/02_ref_mapped_cds/PLRef_NCBI_mapped_cds_{{i}}.fna", i=PLS_IDS)

BAC_REF_MAPPED_GB = expand(f"{OUT}/01_bacterial/03_ref_mapped_genbank/Ref_NCBI_mapped_{{i}}.gb", i=BAC_IDS)
PLS_REF_MAPPED_GB = expand(f"{OUT}/02_plasmids/03_ref_mapped_genbank/PLRef_NCBI_mapped_{{i}}.gb", i=PLS_IDS)

BAC_ALL_PROT = expand(f"{OUT}/01_bacterial/04_all_proteins/Re-annotated_{{i}}.faa", i=BAC_IDS)
PLS_ALL_PROT = expand(f"{OUT}/02_plasmids/04_all_proteins/PLRe-annotated_{{i}}.faa", i=PLS_IDS)

BAC_REF_MAPPED_FAA = expand(f"{OUT}/01_bacterial/04_all_proteins/Ref_NCBI_mapped_{{i}}.faa", i=BAC_IDS)
PLS_REF_MAPPED_FAA = expand(f"{OUT}/02_plasmids/04_all_proteins/PLRef_NCBI_mapped_{{i}}.faa", i=PLS_IDS)

BAC_ONLY = expand(f"{OUT}/01_bacterial/05_only_proteins/Ref_NCBI_only_{{i}}.faa", i=BAC_IDS) + \
           expand(f"{OUT}/01_bacterial/05_only_proteins/Re-annotated_only_{{i}}.faa", i=BAC_IDS)

PLS_ONLY = expand(f"{OUT}/02_plasmids/05_only_proteins/PLRef_NCBI_only_{{i}}.faa", i=PLS_IDS) + \
           expand(f"{OUT}/02_plasmids/05_only_proteins/PLRe-annotated_only_{{i}}.faa", i=PLS_IDS)
           

rule all:
    input:
        BAC_REF_IDS,
        PLS_REF_IDS,
        BAC_REF_MAPPED_CDS,
        PLS_REF_MAPPED_CDS,
        BAC_REF_MAPPED_GB,
        PLS_REF_MAPPED_GB,
        BAC_ALL_PROT,
        PLS_ALL_PROT,
        BAC_REF_MAPPED_FAA,
        PLS_REF_MAPPED_FAA,
        BAC_ONLY,
        PLS_ONLY,
        BAC_REF_ONLY_QC,
        PLS_REF_ONLY_QC,
        f"{OUT}/01_bacterial/07_qc/ref_only_id_recovery_report.tsv",
        f"{OUT}/02_plasmids/07_qc/ref_only_id_recovery_report.tsv",
        f"{OUT}/module4_ready_manifest.tsv"
        

rule prepare_dirs:
    output:
        touch(f"{OUT}/.ready")
    shell:
        r"""
        set -euo pipefail

        mkdir -p "{LOG}"

        mkdir -p "{OUT}/01_bacterial/01_ref_ids"
        mkdir -p "{OUT}/01_bacterial/02_ref_mapped_cds"
        mkdir -p "{OUT}/01_bacterial/03_ref_mapped_genbank"
        mkdir -p "{OUT}/01_bacterial/04_all_proteins"
        mkdir -p "{OUT}/01_bacterial/05_only_proteins"
        mkdir -p "{OUT}/01_bacterial/06_locations"
        mkdir -p "{OUT}/01_bacterial/07_qc/missing_ref_only_ids"


        mkdir -p "{OUT}/02_plasmids/01_ref_ids"
        mkdir -p "{OUT}/02_plasmids/02_ref_mapped_cds"
        mkdir -p "{OUT}/02_plasmids/03_ref_mapped_genbank"
        mkdir -p "{OUT}/02_plasmids/04_all_proteins"
        mkdir -p "{OUT}/02_plasmids/05_only_proteins"
        mkdir -p "{OUT}/02_plasmids/06_locations"
        mkdir -p "{OUT}/02_plasmids/07_qc/missing_ref_only_ids"

        touch "{output}"
        """


# ============================================================
# 1) Clean ref_all_ids.txt
# Remove cds- prefix and export sample-aware IDs
# ============================================================

rule clean_ref_ids_bac:
    input:
        ready=f"{OUT}/.ready",
        ids=f"{CDS_CLASS_DIR}/bac/{{i}}/tmp/ref_all_ids.txt"
    output:
        f"{OUT}/01_bacterial/01_ref_ids/{{i}}_ref_all_ids.txt"
    shell:
        r"""
        set -euo pipefail
        sed 's/^cds-//' "{input.ids}" | sort -u > "{output}"
        test -s "{output}"
        """


rule clean_ref_ids_pls:
    input:
        ready=f"{OUT}/.ready",
        ids=f"{CDS_CLASS_DIR}/pls/{{i}}/tmp/ref_all_ids.txt"
    output:
        f"{OUT}/02_plasmids/01_ref_ids/{{i}}_ref_all_ids.txt"
    shell:
        r"""
        set -euo pipefail
        sed 's/^cds-//' "{input.ids}" | sort -u > "{output}"
        test -s "{output}"
        """


# ============================================================
# 2) Extract mapped reference CDS from NCBI cds.fna
# ============================================================

rule ref_mapped_cds_bac:
    input:
        ids=f"{OUT}/01_bacterial/01_ref_ids/{{i}}_ref_all_ids.txt",
        cds=f"{BAC_CDS_DIR}/Ref_NCBI_cds_{{i}}.fna"
    output:
        f"{OUT}/01_bacterial/02_ref_mapped_cds/Ref_NCBI_mapped_cds_{{i}}.fna"
    shell:
        r"""
        set -euo pipefail

        python3 - <<'PY'
from pathlib import Path

ids_file = Path("{input.ids}")
in_fasta = Path("{input.cds}")
out_fasta = Path("{output}")

ids = [x.strip().replace("cds-", "") for x in ids_file.read_text().splitlines() if x.strip()]
kept = 0
write = False

with open(in_fasta) as inp, open(out_fasta, "w") as out:
    for line in inp:
        if line.startswith(">"):
            header = line.strip()
            write = any(x in header for x in ids)
            if write:
                kept += 1
                out.write(line)
        else:
            if write:
                out.write(line)

print(f"Kept records: {{kept}}")
if kept == 0:
    raise SystemExit("ERROR: no mapped CDS records extracted")
PY

        test -s "{output}"
        """


rule ref_mapped_cds_pls:
    input:
        ids=f"{OUT}/02_plasmids/01_ref_ids/{{i}}_ref_all_ids.txt",
        cds=f"{PLS_CDS_DIR}/PLRef_NCBI_cds_{{i}}.fna"
    output:
        f"{OUT}/02_plasmids/02_ref_mapped_cds/PLRef_NCBI_mapped_cds_{{i}}.fna"
    shell:
        r"""
        set -euo pipefail

        python3 - <<'PY'
from pathlib import Path

ids_file = Path("{input.ids}")
in_fasta = Path("{input.cds}")
out_fasta = Path("{output}")

ids = [x.strip().replace("cds-", "") for x in ids_file.read_text().splitlines() if x.strip()]
