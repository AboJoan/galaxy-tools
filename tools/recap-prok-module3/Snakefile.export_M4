        else:
            if write:
                out.write(line)

print(f"Kept records: {{kept}}")
if kept == 0:
    raise SystemExit("ERROR: no mapped CDS records extracted")
PY

        test -s "{output}"
        """


# ============================================================
# 3) Extract locations from mapped CDS FASTA
# ============================================================

rule locations_bac:
    input:
        f"{OUT}/01_bacterial/02_ref_mapped_cds/Ref_NCBI_mapped_cds_{{i}}.fna"
    output:
        f"{OUT}/01_bacterial/06_locations/{{i}}_locations.txt"
    shell:
        r"""
        set -euo pipefail
        grep "^>" "{input}" | grep -oP '\[location=\K[^\]]+' > "{output}"
        test -s "{output}"
        """


rule locations_pls:
    input:
        f"{OUT}/02_plasmids/02_ref_mapped_cds/PLRef_NCBI_mapped_cds_{{i}}.fna"
    output:
        f"{OUT}/02_plasmids/06_locations/{{i}}_locations.txt"
    shell:
        r"""
        set -euo pipefail
        grep "^>" "{input}" | grep -oP '\[location=\K[^\]]+' > "{output}"
        test -s "{output}"
        """


# ============================================================
# 4) Rescue mapped reference GenBank by CDS locations
# ============================================================

rule ref_mapped_gb_bac:
    input:
        gb=f"{BAC_GB_DIR}/Ref_NCBI_{{i}}.gb",
        loc=f"{OUT}/01_bacterial/06_locations/{{i}}_locations.txt"
    output:
        f"{OUT}/01_bacterial/03_ref_mapped_genbank/Ref_NCBI_mapped_{{i}}.gb"
    shell:
        r"""
        set -euo pipefail

        python3 - <<'PY'
import re
from pathlib import Path

gb_file = Path("{input.gb}")
loc_file = Path("{input.loc}")
out_file = Path("{output}")

coords = set()
for line in loc_file.read_text().splitlines():
    for x in re.findall(r"\d+\.\.\d+", line):
        coords.add(x)

print(f"Loaded coordinates: {{len(coords)}}")
if not coords:
    raise SystemExit("ERROR: no coordinates loaded")

feature_re = re.compile(r"^     (\S+)\s+(.+)")
kept_cds = 0
kept_gene = 0

in_features = False
block = []
keep_block = False

def flush(out):
    global block, keep_block
    if block and keep_block:
        out.writelines(block)

with open(gb_file) as inp, open(out_file, "w") as out:
    for line in inp:
        if line.startswith("FEATURES"):
            in_features = True
            out.write(line)
            continue

        if line.startswith("ORIGIN"):
            flush(out)
            out.write(line)
            in_features = False
            block = []
            keep_block = False
            continue

        if not in_features:
            out.write(line)
            continue

        m = feature_re.match(line)

        if m:
            flush(out)
            block = [line]
            keep_block = False

            ftype = m.group(1)
            loc_text = m.group(2)
            found = re.findall(r"\d+\.\.\d+", loc_text)

            if ftype == "source":
                keep_block = True
            elif ftype in ["gene", "CDS"]:
                if any(x in coords for x in found):
                    keep_block = True
                    if ftype == "CDS":
                        kept_cds += 1
                    elif ftype == "gene":
                        kept_gene += 1
        else:
            block.append(line)

print(f"Kept CDS: {{kept_cds}}")
print(f"Kept genes: {{kept_gene}}")
if kept_cds == 0:
    raise SystemExit("ERROR: no CDS kept in mapped GenBank")
PY

        test -s "{output}"
        """


rule ref_mapped_gb_pls:
    input:
        gb=f"{PLS_GB_DIR}/PLRef_NCBI_{{i}}.gb",
        loc=f"{OUT}/02_plasmids/06_locations/{{i}}_locations.txt"
    output:
        f"{OUT}/02_plasmids/03_ref_mapped_genbank/PLRef_NCBI_mapped_{{i}}.gb"
    shell:
        r"""
