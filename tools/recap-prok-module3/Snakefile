# =========================
# Module3 - FINAL Snakefile
# Liftoff -> CDS classification -> Final tables
# Bacteria + Plasmids
# All intermediates remain inside 02_work
# =========================

from pathlib import Path

WORK   = "02_work"
INP    = "00_input"
SCR    = "03_scripts"
RES    = "04_results"

LOGDIR      = f"{RES}/00_logs"
WORK_MAPDIR = f"{WORK}/01_liftoff_mapping"
WORK_CDSDIR = f"{WORK}/02_cds_classification"
FINALDIR    = f"{RES}/01_final_tables"

REANN_BAC_DIR = f"{INP}/01_re-annotation_genomes/01_bacterial_genomes/02_mapping"
REF_BAC_DIR   = f"{INP}/02_reference_NCBI_genomes/01_bacterial_genomes/02_mapping"

REANN_PLS_CANDIDATES = [
    f"{INP}/01_re-annotation_genomes/02_plasmid_sequences",
    f"{INP}/01_re-annotation_genomes/02_plasmid_sequences/02_mapping",
]

REF_PLS_CANDIDATES = [
    f"{INP}/02_reference_NCBI_genomes/02_plasmid_sequences",
    f"{INP}/02_reference_NCBI_genomes/02_plasmid_sequences/02_mapping",
]


def first_existing_dir(candidates):
    for d in candidates:
        if Path(d).exists():
            return d
    return candidates[0]


REANN_PLS_DIR = first_existing_dir(REANN_PLS_CANDIDATES)
REF_PLS_DIR   = first_existing_dir(REF_PLS_CANDIDATES)


def discover_samples():
    samples = []

    # -------------------------
    # Bacteria
    # -------------------------
    for f in Path(REANN_BAC_DIR).glob("BASIHUMIx_*.fna"):
        gid = f.stem.replace("BASIHUMIx_", "")

        prod_gff = Path(REANN_BAC_DIR) / f"BASIHUMIx_{gid}.prodigal.gff"
        ref_fna  = Path(REF_BAC_DIR)   / f"Ref_NCBI_{gid}.fna"
        ref_gff  = Path(REF_BAC_DIR)   / f"Ref_NCBI_annotation_{gid}.gff"

        if prod_gff.exists() and ref_fna.exists() and ref_gff.exists():
            samples.append(("bac", gid))

    # -------------------------
    # Plasmids
    # -------------------------
    for f in Path(REANN_PLS_DIR).glob("PLSIHUMIx_*.fna"):
        gid = f.stem.replace("PLSIHUMIx_", "")

        prod_gff = Path(REANN_PLS_DIR) / f"PLSIHUMIx_{gid}.prodigal.gff"
        ref_fna  = Path(REF_PLS_DIR)   / f"PLRef_NCBI_{gid}.fna"
        ref_gff1 = Path(REF_PLS_DIR)   / f"PLRef_NCBI_{gid}.gff"
        ref_gff2 = Path(REF_PLS_DIR)   / f"PLRef_NCBI_annotation_{gid}.gff"

        if prod_gff.exists() and ref_fna.exists() and (ref_gff1.exists() or ref_gff2.exists()):
            samples.append(("pls", gid))

    return sorted(samples)


SAMPLES = discover_samples()

if not SAMPLES:
    raise ValueError("No valid samples found.")

print("Detected samples:", SAMPLES)

BAC_SAMPLES = [sid for stype, sid in SAMPLES if stype == "bac"]
PLS_SAMPLES = [sid for stype, sid in SAMPLES if stype == "pls"]

include: "Snakefile.cds_interpretation"

BAC_LIFTOFF_GFFS = expand(
    f"{WORK_MAPDIR}/bac/{{i}}/NCBI_reference_mapped_{{i}}.gff",
    i=BAC_SAMPLES
)

PLS_LIFTOFF_GFFS = expand(
    f"{WORK_MAPDIR}/pls/{{i}}/NCBI_PLreference_mapped_{{i}}.gff",
    i=PLS_SAMPLES
)

BAC_TABLES = expand(
    f"{WORK_CDSDIR}/bac/{{i}}/module3_table3_wide.tsv",
    i=BAC_SAMPLES
)

PLS_TABLES = expand(
    f"{WORK_CDSDIR}/pls/{{i}}/module3_table3_wide.tsv",
    i=PLS_SAMPLES
)


rule all:
    input:
        BAC_LIFTOFF_GFFS,
        PLS_LIFTOFF_GFFS,
        BAC_TABLES,
        PLS_TABLES,
        f"{FINALDIR}/module3_bacterial_summary.tsv",
        f"{FINALDIR}/module3_plasmid_summary.tsv",
        f"{FINALDIR}/module3_legend.txt",
        f"{FINALDIR}/CDS_mapping_summary_NCBI_reference_vs_Prodigal_reannotation.tsv",
        f"{RES}/02_figures/03_cds_mapping_interpretation/Figure_1A_bacterial_chromosomes_NCBI_vs_Prodigal_CDS_mapping.png",
        f"{RES}/02_figures/03_cds_mapping_interpretation/Figure_1B_plasmids_NCBI_vs_Prodigal_CDS_mapping.png",
        f"{RES}/02_figures/03_cds_mapping_interpretation/Figure_2A_bacterial_chromosomes_mean_CDS_length_change.png",
        f"{RES}/02_figures/03_cds_mapping_interpretation/Figure_2B_plasmids_mean_CDS_length_change.png"

rule prepare_dirs:
    output:
        touch(f"{WORK}/.ready")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{WORK}" "{WORK_MAPDIR}" "{WORK_CDSDIR}"
        mkdir -p "{LOGDIR}" "{FINALDIR}"
        touch "{output}"
        """


# ============================================================
# Liftoff - bacteria
# ============================================================
rule liftoff_bac:
    input:
        ready=f"{WORK}/.ready",
        qry=f"{REANN_BAC_DIR}/BASIHUMIx_{{i}}.fna",
        ref=f"{REF_BAC_DIR}/Ref_NCBI_{{i}}.fna",
        gff=f"{REF_BAC_DIR}/Ref_NCBI_annotation_{{i}}.gff"
    output:
        gff=f"{WORK_MAPDIR}/bac/{{i}}/NCBI_reference_mapped_{{i}}.gff"
    log:
        f"{LOGDIR}/liftoff_bac_{{i}}.log"
    threads: 8
    shell:
        r"""
        set -euo pipefail

        outdir="$(dirname "{output.gff}")"
        mkdir -p "$outdir"
        mkdir -p "$(dirname "{log}")"

        rm -rf "$outdir"
        mkdir -p "$outdir"

        qry_abs="$(readlink -f "{input.qry}")"
        ref_abs="$(readlink -f "{input.ref}")"
        gff_abs="$(readlink -f "{input.gff}")"
        log_abs="$(readlink -f "$(dirname "{log}")")/$(basename "{log}")"

        cd "$outdir"

        liftoff "$qry_abs" "$ref_abs" -g "$gff_abs" \
          -o "NCBI_reference_mapped_{wildcards.i}.gff" \
          -p {threads} \
          > "$log_abs" 2>&1

        test -s "NCBI_reference_mapped_{wildcards.i}.gff"
        """


# ============================================================
# Liftoff - plasmids
# Output name:
#   NCBI_PLreference_mapped_*.gff
# ============================================================
rule liftoff_pls:
    input:
        ready=f"{WORK}/.ready",
        qry=lambda wc: f"{REANN_PLS_DIR}/PLSIHUMIx_{wc.i}.fna",
        ref=lambda wc: f"{REF_PLS_DIR}/PLRef_NCBI_{wc.i}.fna",
        gff=lambda wc: (
            f"{REF_PLS_DIR}/PLRef_NCBI_{wc.i}.gff"
            if Path(f"{REF_PLS_DIR}/PLRef_NCBI_{wc.i}.gff").exists()
            else f"{REF_PLS_DIR}/PLRef_NCBI_annotation_{wc.i}.gff"
        )
    output:
        gff=f"{WORK_MAPDIR}/pls/{{i}}/NCBI_PLreference_mapped_{{i}}.gff"
    log:
        f"{LOGDIR}/liftoff_pls_{{i}}.log"
    threads: 8
    shell:
        r"""
        set -euo pipefail

        outdir="$(dirname "{output.gff}")"
        mkdir -p "$outdir"
        mkdir -p "$(dirname "{log}")"

        rm -rf "$outdir"
        mkdir -p "$outdir"

        qry_abs="$(readlink -f "{input.qry}")"
        ref_abs="$(readlink -f "{input.ref}")"
        gff_abs="$(readlink -f "{input.gff}")"
        log_abs="$(readlink -f "$(dirname "{log}")")/$(basename "{log}")"

        cd "$outdir"

        liftoff "$qry_abs" "$ref_abs" -g "$gff_abs" \
          -o "NCBI_PLreference_mapped_{wildcards.i}.gff" \
          -p {threads} \
          > "$log_abs" 2>&1

        test -s "NCBI_PLreference_mapped_{wildcards.i}.gff"
        """


# ============================================================
# CDS classification - bacteria
# ============================================================
rule cds_classification_bac:
    input:
        mapped=f"{WORK_MAPDIR}/bac/{{i}}/NCBI_reference_mapped_{{i}}.gff",
        prod=f"{REANN_BAC_DIR}/BASIHUMIx_{{i}}.prodigal.gff"
    output:
        table=f"{WORK_CDSDIR}/bac/{{i}}/module3_table3_wide.tsv"
    log:
        f"{LOGDIR}/cds_bac_{{i}}.log"
    shell:
        r"""
        set -euo pipefail

        outdir="$(dirname "{output.table}")"
        mkdir -p "$outdir"
        mkdir -p "$(dirname "{log}")"

        rm -rf "$outdir"/tmp "$outdir"/gff
        rm -f "$outdir"/module3_table3_wide.tsv "$outdir"/pairs_one2one.tsv "$outdir"/pairs_classified.tsv

        bash "{SCR}/module3_table3_columns.sh" \
          "{input.mapped}" \
          "{input.prod}" \
          "$outdir" \
          > "{log}" 2>&1

        test -s "{output.table}"
        """


# ============================================================
# CDS classification - plasmids
# ============================================================
rule cds_classification_pls:
    input:
        mapped=f"{WORK_MAPDIR}/pls/{{i}}/NCBI_PLreference_mapped_{{i}}.gff",
        prod=lambda wc: f"{REANN_PLS_DIR}/PLSIHUMIx_{wc.i}.prodigal.gff"
    output:
        table=f"{WORK_CDSDIR}/pls/{{i}}/module3_table3_wide.tsv"
    log:
        f"{LOGDIR}/cds_pls_{{i}}.log"
    shell:
        r"""
        set -euo pipefail

        outdir="$(dirname "{output.table}")"
        mkdir -p "$outdir"
        mkdir -p "$(dirname "{log}")"

        rm -rf "$outdir"/tmp "$outdir"/gff
        rm -f "$outdir"/module3_table3_wide.tsv "$outdir"/pairs_one2one.tsv "$outdir"/pairs_classified.tsv

        bash "{SCR}/module3_table3_columns.sh" \
          "{input.mapped}" \
          "{input.prod}" \
          "$outdir" \
          > "{log}" 2>&1

        test -s "{output.table}"
        """


rule merge_bacteria:
    input:
        BAC_TABLES
    output:
        f"{FINALDIR}/module3_bacterial_summary.tsv"
    run:
        import pandas as pd
        from pathlib import Path

        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)

        columns = [
            "Genome",
            "REF_CDS_{a}",
            "PRO_CDS_{b}",
            "MATCH_ALL_{c}",
            "START_LOC_STOP_PRO_{d}",
            "STOP_LOC_START_PRO_{e}",
            "START_STOP_LOC_CHANGE_{f}",
            "REF_ONLY_{g}",
            "PRO_ONLY_{h}",
            "FINAL_CDS_{i}",
        ]

        dfs = []

        for file in input:
            df = pd.read_csv(file, sep="\t")
            if not df.empty:
                dfs.append(df)

        if dfs:
            result = pd.concat(dfs, ignore_index=True)
        else:
            result = pd.DataFrame(columns=columns)

        result.to_csv(output[0], sep="\t", index=False)

rule merge_plasmids:
    input:
        PLS_TABLES
    output:
        f"{FINALDIR}/module3_plasmid_summary.tsv"
    run:
        import pandas as pd
        from pathlib import Path

        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)

        columns = [
            "Genome",
            "REF_CDS_{a}",
            "PRO_CDS_{b}",
            "MATCH_ALL_{c}",
            "START_LOC_STOP_PRO_{d}",
            "STOP_LOC_START_PRO_{e}",
            "START_STOP_LOC_CHANGE_{f}",
            "REF_ONLY_{g}",
            "PRO_ONLY_{h}",
            "FINAL_CDS_{i}",
        ]

        dfs = []

        for file in input:
            df = pd.read_csv(file, sep="\t")
            if not df.empty:
                dfs.append(df)

        if dfs:
            result = pd.concat(dfs, ignore_index=True)
        else:
            result = pd.DataFrame(columns=columns)

        result.to_csv(output[0], sep="\t", index=False)
        
print("Detected bacterial samples:", BAC_SAMPLES)
print("Detected plasmid samples:", PLS_SAMPLES)

rule legend:
    output:
        f"{FINALDIR}/module3_legend.txt"
    shell:
        r"""
cat << 'EOF' > {output}
Definitions of column acronyms/ 
Table 1+2: CDS mapping categories between the Prodigal and the reference NCBI bacterial_&_plasmid CDS sets per genome.

REF_CDS_{{a}} /  Number of CDS in the mapped reference annotation.
REANN_CDS_{{b}} /   Number of CDS predicted by Prodigal.
MATCH_ALL_{{c}} /  Number of CDS where  the start codon, stop codon and loci match
START_LOC_STOP_PRO_{{d}} /  Number of CDS where the start codon and its loci match, but the stop codon in Prodigal do not
STOP_LOC_START_PRO_{{e}} /  Number of CDS where the stop codon and its loci match, but the start codon in Prodigal do not 
START_STOP_LOC_CHANGE_{{f}} /   Number of CDS where the start codon and stop codons match, but their loci change 
REF_ONLY_{{g}} /  Number of CDS present in the reference but absent in Prodigal
PRO_ONLY_{{h}} /  Number of CDS present in Prodigal but absent in the reference
FINAL_CDS_{{i}} /  The total number of re-annotated CDS after integrating mapping categories
-----------------------------------------------------------------------------------------------------------------------
Table 3: Summary of CDS Boundary Refinements Between Reference and Prodigal Genomes.
ST_{{a}} /  indicates the sequence type.
EM_{{b}} /  indicates exact matches between reference and Prodigal CDS sets.
EM(%)_{{c}} /  indicates the percentage of exact matches between the reference and Prodigal CDS sets.
EXT_{{d}} /  indicates Prodigal CDS extensions relative to the reference CDS sets.
EXT(%)_{{e}} /  indicates the percentage of Prodigal CDS extensions relative to the reference CDS sets.
TRUNC_{{f}} /  indicates Prodigal CDS truncations relative to the reference CDS sets. 
TRUNC(%)_{{g}} /  indicates the percentage of Prodigal CDS truncations relative to the reference CDS sets.
LS_{{h}} /  indicates the locus shifts.
Mean_∆CDS(bp)_{{i}} /  indicates mean CDS length difference between Prodigal and reference CDS sets.

        """
        
