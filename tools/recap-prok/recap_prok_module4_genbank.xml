        <citation type="bibtex"><![CDATA[
@software{recap_prok,
  author = {Ataa, Asaad},
  title = {RECAP-PROK},
  url = {https://github.com/AboJoan/RECAP-PROK},
  year = {2026}
}
    ]]></citation>
    </citations>
</tool>
