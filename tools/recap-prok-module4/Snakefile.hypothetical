#!/usr/bin/env python3
# ============================
# Snakefile.hypothetical  (FINAL / CLEAN)
# Build GenBank (re-annotation) -> Compare vs Reference -> Table -> Figures
# Naming rules supported:
#   Bacteria:
#     Re-annotated_01.gb  <-> Ref_NCBI_01.gb
#     Re-annotated_03.gb  <-> Ref_NCBI_03.gb
#   Plasmids:
#     PLRe-annotated_02.gb               <-> PLRef_NCBI_02.gb
#     Putative_PLRe-annotated_03_01.gb   <-> Putative_PLRef_NCBI_03_01.gb
# ============================

import os
import re
import csv
import subprocess
from pathlib import Path

# ----------------------------
# Inputs
# ----------------------------
METADATA_TSV = "00_input/03_genbank/01_metadata/03_replicon_metadata.tsv"
PFAM_DUF_MAP = "00_input/pfam_duf_map.tsv"

BAC_IN   = "00_input/03_genbank/01_Prodigal/01_bacterial"
PLS_IN   = "00_input/03_genbank/01_Prodigal/02_plasmid"

EGG_BAC  = "00_input/03_genbank/03_eggNOG/01_bacteria"
EGG_PLS  = "00_input/03_genbank/03_eggNOG/02_plasmid"

# Re-annotation GenBanks (outputs of Build_GenBank.py)
BAC_GB_DIR = "00_input/04_hypothetical_genes/01_Re-annotated_bacterial_genbank"
PLS_GB_DIR = "00_input/04_hypothetical_genes/03_Re-annotated_plasmids_genbank"

# Reference GenBanks (already exist)
BAC_REF_DIR = "00_input/04_hypothetical_genes/02_Reference_bacterial_genbank"
PLS_REF_DIR = "00_input/04_hypothetical_genes/04_Reference_plasmids_genbank"

TABLES = "04_results/01_final_tables"
FIGS   = "04_results/02_figures/02_functional_comparison"
LOGS   = "04_results/00_logs"

os.makedirs(BAC_GB_DIR, exist_ok=True)
os.makedirs(PLS_GB_DIR, exist_ok=True)
os.makedirs(TABLES, exist_ok=True)
os.makedirs(FIGS, exist_ok=True)
os.makedirs(LOGS, exist_ok=True)

# ----------------------------
# Metadata loader (fallback mapping)
# ----------------------------
def load_meta(tsv_path: str):
    rows = []
    with open(tsv_path, newline="", encoding="utf-8", errors="replace") as fh:
        reader = csv.DictReader(fh, delimiter="\t")
        for r in reader:
            rows.append(r)
    return rows

META_ROWS = load_meta(METADATA_TSV)

def strip_version(acc: str) -> str:
    return re.sub(r"\.\d+$", "", (acc or "").strip())

def is_accession_like(s: str) -> bool:
    """
    Very permissive replicon accession check.
    Accepts: NZ_CP..., NC_..., CP..., etc (optionally with .1)
    """
    if not s:
        return False
    s = s.strip()
    return bool(re.match(r"^(NZ_|NC_|CP|AP|AE|AF|U|J|L|M)[A-Z0-9_]+(\.\d+)?$", s))

def first_fasta_token(fna_path: str) -> str:
    with open(fna_path, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if line.startswith(">"):
                return line[1:].strip().split()[0]
    return ""

def meta_accession_for_id(id_str: str) -> str:
    """
    Fallback when FASTA header is NOT an accession.
    We map by suffix _XX via Genome_ID or Inf (your TSV uses those).
    """
    id2 = str(int(id_str)).zfill(2)

    for r in META_ROWS:
        gid = (r.get("Genome_ID") or "").strip()
        inf = (r.get("Inf") or "").strip()

        if gid.endswith(id2) or inf.endswith(id2) or inf.endswith(f"genome_{id2}"):
            acc = (r.get("Replicon_accession_norm") or r.get("Replicon_accession") or "").strip()
            if acc:
                return acc
    return ""

def replicon_from_fna_or_meta(fna_path: str, id_str: str) -> str:
    tok = first_fasta_token(fna_path)
    if is_accession_like(tok):
        return tok
    acc = meta_accession_for_id(id_str)
    if not acc:
        raise ValueError(
            f"[ERROR] Cannot determine replicon accession for id={id_str}. "
            f"FASTA token='{tok}' not accession-like AND metadata fallback failed."
        )
    return acc

# ----------------------------
# Discover inputs automatically (NO genes_cds)
# ----------------------------
def bacterial_ids():
    ids = []
    for p in Path(BAC_IN).glob("Re-annotated_*.fna"):
        if "genes_cds" in p.name:
            continue
        m = re.match(r"^Re-annotated_(\d+)\.fna$", p.name)
        if m:
            ids.append(m.group(1))
    return sorted(set(ids), key=lambda x: int(x))

def plasmid_ids():
    ids = []
    for p in Path(PLS_IN).glob("PLRe-annotated_*.fna"):
        if "genes_cds" in p.name:
            continue
        m = re.match(r"^PLRe-annotated_(\d+)\.fna$", p.name)
        if m:
            ids.append(m.group(1))
    return sorted(set(ids), key=lambda x: int(x))

def putative_pairs():
    """
    Putative plasmids:
      Putative_PLRe-annotated_03_01.fna
      Putative_PLRe-annotated_03_02.fna
    """
    pairs = []
    for p in Path(PLS_IN).glob("Putative_PLRe-annotated_*.fna"):
        if "genes_cds" in p.name:
            continue
        m = re.match(r"^Putative_PLRe-annotated_(\d+)_(\d+)\.fna$", p.name)
        if m:
            pairs.append((m.group(1), m.group(2)))
    return sorted(set(pairs), key=lambda x: (int(x[0]), int(x[1])))

BAC_IDS    = bacterial_ids()
PLS_IDS    = plasmid_ids()
PUT_PAIRS  = putative_pairs()

BAC_GBS = [f"{BAC_GB_DIR}/Re-annotated_{i}.gb" for i in BAC_IDS]
PLS_GBS = [f"{PLS_GB_DIR}/PLRe-annotated_{i}.gb" for i in PLS_IDS]
PUT_GBS = [f"{PLS_GB_DIR}/Putative_PLRe-annotated_{i}_{j}.gb" for (i, j) in PUT_PAIRS]

BAC_TSV = f"{TABLES}/04_01_genbank_hypothetical_comparison.tsv"
BAC_CSV = f"{TABLES}/04_01_genbank_hypothetical_comparison.csv"

PLS_TSV = f"{TABLES}/05_01_genbank_pls_hypothetical_comparison.tsv"
PLS_CSV = f"{TABLES}/05_01_genbank_pls_hypothetical_comparison.csv"

BAC_PDF  = f"{FIGS}/Hypo_Re-annotated_vs_NCBI.pdf"
BAC_TIFF = f"{FIGS}/Hypo_Re-annotated_vs_NCBI.tiff"

PLS_PDF  = f"{FIGS}/Pls_Hypo_Re-annotation_vs_NCBI.pdf"
PLS_TIFF = f"{FIGS}/Pls_Hypo_Re-annotation_vs_NCBI.tiff"


# ----------------------------
# Master target
# ----------------------------
rule hypothetical_pipeline:
    input:
        # Force building ALL re-annotation GenBanks found
        BAC_GBS,
        PLS_GBS,
        PUT_GBS,

        # Tables
        BAC_TSV, BAC_CSV,
        PLS_TSV, PLS_CSV,

        # Figures
        BAC_PDF, BAC_TIFF,
        PLS_PDF, PLS_TIFF


# ============================
# 1) Build GenBank (bacterial)
# ============================
rule build_genbank_bacterial:
    input:
        fna=f"{BAC_IN}/Re-annotated_{{id}}.fna",
        faa=f"{BAC_IN}/Re-annotated_{{id}}.proteins.faa",
        gff=f"{BAC_IN}/Re-annotated_{{id}}.prodigal.gff",
        egg=f"{EGG_BAC}/Re-annotated_{{id}}.csv",
        meta=METADATA_TSV,
        pfam=PFAM_DUF_MAP
    output:
        gb=f"{BAC_GB_DIR}/Re-annotated_{{id}}.gb"
    log:
        f"{LOGS}/01_build_bac_{{id}}.log"
    run:
        rid = replicon_from_fna_or_meta(input.fna, wildcards.id)
        cmd = [
            "python3", "03_scripts/03_build_genbank/Build_GenBank.py",
            "--metadata", input.meta,
            "--replicon_accession", rid,
            "--fna", input.fna,
            "--faa", input.faa,
            "--gff", input.gff,
            "--eggnog_csv", input.egg,
            "--pfam_duf_map", input.pfam,
            "--out_gbk", output.gb,
            "--topology", "circular",
        ]
        with open(log[0], "w") as L:
            L.write(f"[RUN] replicon_accession={rid}\n")
            L.flush()
            subprocess.check_call(cmd, stdout=L, stderr=L)
        assert Path(output.gb).exists() and Path(output.gb).stat().st_size > 0


# ============================
# 1b) Build GenBank (plasmid normal)
# ============================
rule build_genbank_plasmid:
    input:
        fna=f"{PLS_IN}/PLRe-annotated_{{id}}.fna",
        faa=f"{PLS_IN}/PLRe-annotated_{{id}}.proteins.faa",
        gff=f"{PLS_IN}/PLRe-annotated_{{id}}.prodigal.gff",
        egg=f"{EGG_PLS}/PLRe-annotated_{{id}}.csv",
        meta=METADATA_TSV,
        pfam=PFAM_DUF_MAP
    output:
        gb=f"{PLS_GB_DIR}/PLRe-annotated_{{id}}.gb"
    log:
        f"{LOGS}/02_build_pls_{{id}}.log"
    run:
        rid = replicon_from_fna_or_meta(input.fna, wildcards.id)
        cmd = [
            "python3", "03_scripts/03_build_genbank/Build_GenBank.py",
            "--metadata", input.meta,
            "--replicon_accession", rid,
            "--fna", input.fna,
            "--faa", input.faa,
            "--gff", input.gff,
            "--eggnog_csv", input.egg,
            "--pfam_duf_map", input.pfam,
            "--out_gbk", output.gb,
            "--topology", "circular",
        ]
        with open(log[0], "w") as L:
            L.write(f"[RUN] replicon_accession={rid}\n")
            L.flush()
            subprocess.check_call(cmd, stdout=L, stderr=L)
        assert Path(output.gb).exists() and Path(output.gb).stat().st_size > 0


# ============================
# 1c) Build GenBank (plasmid putative)
# ============================
rule build_genbank_plasmid_putative:
    input:
        fna=f"{PLS_IN}/Putative_PLRe-annotated_{{id}}_{{sub}}.fna",
        faa=f"{PLS_IN}/Putative_PLRe-annotated_{{id}}_{{sub}}.proteins.faa",
        gff=f"{PLS_IN}/Putative_PLRe-annotated_{{id}}_{{sub}}.prodigal.gff",
        # eggNOG is still by the main genome id (your structure)
        egg=f"{EGG_PLS}/PLRe-annotated_{{id}}.csv",
        meta=METADATA_TSV,
        pfam=PFAM_DUF_MAP
    output:
        gb=f"{PLS_GB_DIR}/Putative_PLRe-annotated_{{id}}_{{sub}}.gb"
    log:
        f"{LOGS}/03_build_pls_put_{{id}}_{{sub}}.log"
    run:
        rid = replicon_from_fna_or_meta(input.fna, wildcards.id)
        cmd = [
            "python3", "03_scripts/03_build_genbank/Build_GenBank.py",
            "--metadata", input.meta,
            "--replicon_accession", rid,
            "--fna", input.fna,
            "--faa", input.faa,
            "--gff", input.gff,
            "--eggnog_csv", input.egg,
            "--pfam_duf_map", input.pfam,
            "--out_gbk", output.gb,
            "--topology", "circular",
        ]
        with open(log[0], "w") as L:
            L.write(f"[RUN] replicon_accession={rid}\n")
            L.flush()
            subprocess.check_call(cmd, stdout=L, stderr=L)
        assert Path(output.gb).exists() and Path(output.gb).stat().st_size > 0


# ============================
# 2) Compare tables
# ============================
rule compare_bac:
    input:
        BAC_GBS
    output:
        tsv=BAC_TSV,
        csv=BAC_CSV
    log:
        f"{LOGS}/04_compare_bac.log"
    shell:
        r"""
        set -euo pipefail
        python3 03_scripts/04_comparasion_functional/compare_genbank_hypothetical.py \
          --mode bac \
          --reann_dir "{BAC_GB_DIR}" \
          --ref_dir  "{BAC_REF_DIR}" \
          --out_prefix "{TABLES}/04_01_genbank_hypothetical_comparison" \
          --label_reann "Re-annotated" \
          --label_ref  "NCBI Reference genome" \
          > "{log}" 2>&1
        test -s "{output.tsv}"
        test -s "{output.csv}"
        """

rule compare_pls:
    input:
        PLS_GBS + PUT_GBS
    output:
        tsv=PLS_TSV,
        csv=PLS_CSV
    log:
        f"{LOGS}/05_compare_pls.log"
    shell:
        r"""
        set -euo pipefail
        python3 03_scripts/04_comparasion_functional/compare_genbank_hypothetical.py \
          --mode pls \
          --reann_dir "{PLS_GB_DIR}" \
          --ref_dir  "{PLS_REF_DIR}" \
          --out_prefix "{TABLES}/05_01_genbank_pls_hypothetical_comparison" \
          --label_reann "Re-annotated" \
          --label_ref  "NCBI Reference genome" \
          > "{log}" 2>&1
        test -s "{output.tsv}"
        test -s "{output.csv}"
        """


# ============================
# 3) Plots (R)
# ============================
rule plot_bac:
    input:
        tsv=BAC_TSV
    output:
        pdf=BAC_PDF,
        tiff=BAC_TIFF
    log:
        f"{LOGS}/06_plot_bac.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{FIGS}"
        Rscript 03_scripts/04_comparasion_functional/plot_hypothetical_barplot.R \
          "{input.tsv}" "{output.pdf}" "{output.tiff}" \
          > "{log}" 2>&1
        test -s "{output.pdf}"
        test -s "{output.tiff}"
        """

rule plot_pls:
    input:
        tsv=PLS_TSV
    output:
        pdf=PLS_PDF,
        tiff=PLS_TIFF
    log:
        f"{LOGS}/07_plot_pls.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{FIGS}"
        Rscript 03_scripts/04_comparasion_functional/plot_hypothetical_barplot.R \
          "{input.tsv}" "{output.pdf}" "{output.tiff}" \
          > "{log}" 2>&1
        test -s "{output.pdf}"
        test -s "{output.tiff}"
        """
