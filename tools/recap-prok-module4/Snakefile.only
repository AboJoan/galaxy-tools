# Snakefile.only
# Use pre-generated eggNOG *_ONLY.csv files as canonical inputs.
# No filtering from IDs is performed in this workflow.

import re
from pathlib import Path

INP = "00_input"
LOGDIR = "04_results/00_logs"

ONLY_BASE = f"{INP}/02_novel_missing_genes"

ONLY_BAC_REANN = f"{ONLY_BASE}/01_Re-annotated_only_genes"
ONLY_BAC_REF   = f"{ONLY_BASE}/02_Ref_NCBI_only_genes"
ONLY_PLS_REANN = f"{ONLY_BASE}/03_Re-annotated_Plasmid_only_genes"
ONLY_PLS_REF   = f"{ONLY_BASE}/04_PLRef_NCBI_only_genes"

ONLY_QC = f"{ONLY_BASE}/00_qc"


def sort_ids(ids):
    return sorted(set(ids), key=lambda x: (len(x), x))


def discover_only_ids(dirp, prefix):
    ids = []
    d = Path(dirp)

    if not d.exists():
        return []

    for p in d.glob(f"{prefix}_*_ONLY.csv"):
        m = re.match(rf"^{re.escape(prefix)}_(.+)_ONLY\.csv$", p.name)
        if m:
            ids.append(m.group(1))

    return sort_ids(ids)


BAC_REANN_IDS = discover_only_ids(ONLY_BAC_REANN, "Re-annotated")
BAC_REF_IDS   = discover_only_ids(ONLY_BAC_REF,   "Ref_NCBI")
PLS_REANN_IDS = discover_only_ids(ONLY_PLS_REANN, "PLRe-annotated")
PLS_REF_IDS   = discover_only_ids(ONLY_PLS_REF,   "PLRef_NCBI")

print("Detected bacterial Re-annotated-only CSV IDs:", BAC_REANN_IDS)
print("Detected bacterial Ref_NCBI-only CSV IDs:", BAC_REF_IDS)
print("Detected plasmid PLRe-annotated-only CSV IDs:", PLS_REANN_IDS)
print("Detected plasmid PLRef_NCBI-only CSV IDs:", PLS_REF_IDS)

BAC_REANN_ONLY = expand(f"{ONLY_BAC_REANN}/Re-annotated_{{i}}_ONLY.csv", i=BAC_REANN_IDS)
BAC_REF_ONLY   = expand(f"{ONLY_BAC_REF}/Ref_NCBI_{{i}}_ONLY.csv", i=BAC_REF_IDS)
PLS_REANN_ONLY = expand(f"{ONLY_PLS_REANN}/PLRe-annotated_{{i}}_ONLY.csv", i=PLS_REANN_IDS)
PLS_REF_ONLY   = expand(f"{ONLY_PLS_REF}/PLRef_NCBI_{{i}}_ONLY.csv", i=PLS_REF_IDS)

ALL_ONLY_INPUTS = BAC_REANN_ONLY + BAC_REF_ONLY + PLS_REANN_ONLY + PLS_REF_ONLY


rule only_all:
    input:
        f"{ONLY_BASE}/.only_done"


rule only_prepare_dirs:
    output:
        touch(f"{ONLY_BASE}/.only_dirs_ready")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{ONLY_BAC_REANN}" "{ONLY_BAC_REF}" "{ONLY_PLS_REANN}" "{ONLY_PLS_REF}"
        mkdir -p "{ONLY_QC}" "{LOGDIR}"
        touch "{output}"
        """


rule only_validate_inputs:
    input:
        ready=f"{ONLY_BASE}/.only_dirs_ready",
        only_files=ALL_ONLY_INPUTS
    output:
        manifest=f"{ONLY_QC}/only_input_manifest.tsv"
    run:
        from pathlib import Path

        files = [Path(str(x)) for x in input.only_files]

        if len(files) == 0:
            raise ValueError(
                "No *_ONLY.csv files were detected under 00_input/02_novel_missing_genes."
            )

        rows = []

        for p in files:
            if not p.exists():
                raise FileNotFoundError(str(p))

            if p.stat().st_size == 0:
                raise ValueError(f"Empty ONLY CSV file: {p}")

            rel = str(p)

            if "01_Re-annotated_only_genes" in rel:
                category = "bacterial_reannotated_only"
            elif "02_Ref_NCBI_only_genes" in rel:
                category = "bacterial_ref_only"
            elif "03_Re-annotated_Plasmid_only_genes" in rel:
                category = "plasmid_reannotated_only"
            elif "04_PLRef_NCBI_only_genes" in rel:
                category = "plasmid_ref_only"
            else:
                category = "unknown"

            with open(p) as fh:
                line_count = sum(1 for _ in fh)

            data_rows = max(0, line_count - 1)

            rows.append([
                category,
                p.name,
                str(p),
                str(p.stat().st_size),
                str(data_rows),
            ])

        out = Path(output.manifest)
        out.parent.mkdir(parents=True, exist_ok=True)

        with open(out, "w") as fh:
            fh.write("category\tfilename\tpath\tsize_bytes\tdata_rows\n")
            for row in rows:
                fh.write("\t".join(row) + "\n")


rule only_done:
    input:
        manifest=f"{ONLY_QC}/only_input_manifest.tsv"
    output:
        touch(f"{ONLY_BASE}/.only_done")
    shell:
        r"""
        set -euo pipefail
        test -s "{input.manifest}"
        touch "{output}"
        """
